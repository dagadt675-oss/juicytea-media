 "sentences": [
  {
   "speaker": "narrator",
   "text": "This map says Greenland is as big as AFRICA.",
   "t0": 0.15,
   "t1": 3.13
  },
  {
   "speaker": "narrator",
   "text": "It's not even as big as ALGERIA.",
   "t0": 3.345,
   "t1": 5.282
  },
  {
   "speaker": "greenland",
   "text": "Excuse me?",
   "t0": 5.63,
   "t1": 6.583
  },
  {
   "speaker": "narrator",
   "text": "Here's the trick.",
   "t0": 6.897,
   "t1": 7.768
  },
  {
   "speaker": "narrator",
   "text": "To flatten a round Earth, this map stretches land more and more toward the poles.",
   "t0": 8.232,
   "t1": 12.645
  },
  {
   "speaker": "narrator",
   "text": "Up where Greenland sits, that's about SIXTEEN times too big.",
   "t0": 13.162,
   "t1": 16.727
  },
  {
   "speaker": "narrator",
   "text": "So let's drag Greenland down to the equator, where the map tells the truth...",
   "t0": 17.198,
   "t1": 20.97
  },
  {
   "speaker": "narrator",
   "text": "Watch it shrink.",
   "t0": 21.46,
   "t1": 22.598
  },
  {
   "speaker": "narrator",
   "text": "And shrink.",
   "t0": 22.855,
   "t1": 23.815
  },
  {
   "speaker": "narrator",
   "text": "And SHRINK.",
   "t0": 24.148,
   "t1": 25.168
  },
  {
   "speaker": "greenland",
   "text": "Wait... what?!",
   "t0": 25.498,
   "t1": 26.867
  },
  {
   "speaker": "narrator",
   "text": "Now drop it on Africa.",
   "t0": 27.183,
   "t1": 28.475
  },
  {
   "speaker": "narrator",
   "text": "Africa is FOURTEEN times bigger.",
   "t0": 28.977,
   "t1": 31.095
  },
  {
   "speaker": "narrator",
   "text": "Even Algeria is bigger than Greenland.",
   "t0": 31.55,
   "t1": 33.483
  },
  {
   "speaker": "narrator",
   "text": "So is DR Congo.",
   "t0": 33.792,
   "t1": 35.188
  },
  {
   "speaker": "algeria",
   "text": "Hi, tiny.",
   "t0": 35.53,
   "t1": 36.767
  },
  {
   "speaker": "narrator",
   "text": "In fact, put the USA, China, India, and all of Europe outside Russia together...",
   "t0": 37.083,
   "t1": 42.392
  },
  {
   "speaker": "narrator",
   "text": "and Africa is STILL bigger.",
   "t0": 42.763,
   "t1": 44.443
  },
  {
   "speaker": "narrator",
   "text": "With room to spare.",
   "t0": 44.752,
   "t1": 45.928
  },
  {
   "speaker": "narrator",
   "text": "So next time someone shows you this map...",
   "t0": 46.377,
   "t1": 48.26
  },
  {
   "speaker": "narrator",
   "text": "remember: Greenland isn't huge.",
   "t0": 48.645,
   "t1": 50.91
  },
  {
   "speaker": "narrator",
   "text": "The map is LYING.",
   "t0": 51.19,
   "t1": 52.347
  }
 ],
