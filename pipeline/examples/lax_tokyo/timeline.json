      },
      "claim": "It bends *NORTH*\ntoward Alaska",
      "sub": "Toward the Aleutians"
    },
    {
      "index": 6,
      "text": "That route is hundreds of kilometers shorter than the straight line your map shows.",
      "say": "That route is hundreds of kilometers shorter than the straight line your map shows.",
      "kind": "s",
      "start": 13.9,
      "end": 18.1,
      "gap": 0.0,
      "words": [],
