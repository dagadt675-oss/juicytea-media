      },
      "claim": "Earth is a\n*SPHERE*",
      "sub": "A round Earth"
    },
    {
      "index": 4,
      "text": "the shortest path is a great-circle arc",
      "say": "the shortest path is a great-circle arc",
      "kind": "s",
      "start": 9.7,
      "end": 12.05,
      "gap": 0.0,
      "words": [],
      "on_screen": {
        "claim": "Shortest path:\na *GREAT CIRCLE*",
        "sub": "An arc, not that straight line"
      },
      "claim": "Shortest path:\na *GREAT CIRCLE*",
      "sub": "An arc, not that straight line"
    },
    {
      "index": 5,
      "text": "that bends north toward Alaska.",
      "say": "that bends north toward Alaska.",
